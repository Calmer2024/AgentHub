{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentHub Local Desktop",
  "version": "0.1.0",
  "identifier": "local.agenthub.desktop",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev:local",
    "beforeBuildCommand": "cd ../frontend && npm run build:local",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../frontend/dist-local"
  },
  "app": {
    "windows": [
      {
        "title": "AgentHub Local",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 720
      }
    ]
  }
}
