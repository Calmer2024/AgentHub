{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentHub",
  "version": "1.0.0",
  "identifier": "local.agenthub.desktop",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev:local -- --host 127.0.0.1 --port 5173 --strictPort",
    "beforeBuildCommand": "npm run build:frontend",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../frontend/dist-local"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentHub",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 720,
        "decorations": false,
        "resizable": true,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/agenthub-backend.exe"]
  }
}
